# ── Base de datos ──
# Local (docker-compose): la de abajo.
# Producción en Hostinger (hosting compartido/Business): Hostinger NO ofrece
# Postgres en esos planes. Conectá una base gestionada — la vía más simple es
# el botón nativo "Connect → Supabase" del panel de tu Node.js App (Supabase
# es Postgres con soporte PostGIS, así que el schema.prisma no cambia). Ver
# DEPLOY.md.
DATABASE_URL="postgresql://vida_solidaria:changeme@localhost:5432/vida_solidaria?schema=public"

# ── Redis (opcional) ──
# El hosting compartido/Business de Hostinger no ofrece Redis (mismo motivo
# que Postgres). Nada del Módulo 1 lo necesita. Dejalo vacío en ese hosting;
# completalo solo si en el futuro migrás a VPS o sumás un Redis externo
# (ej. Upstash) para escalar Socket.IO a más de una instancia.
REDIS_URL=""

# ── JWT ──
JWT_ACCESS_SECRET="changeme-access-secret"
JWT_REFRESH_SECRET="changeme-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# ── Google OAuth ──
# Callback en el subdominio del backend (ver DEPLOY.md sobre 1 vs 2 Node.js Apps)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://api.vidasolidaria.org/api/auth/google/callback"

# ── Servidor ──
# En Hostinger Node.js App, el puerto lo asigna la plataforma — no lo fijes
# vos ahí (dejalo en el valor que Hostinger inyecte). PORT=4000 es solo para
# desarrollo local.
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ── Almacenamiento de archivos ──
UPLOADS_DIR="./uploads"

# ── Cookies ──
# Dominio PADRE compartido entre el subdominio del frontend y el del backend
# (ej. ".vidasolidaria.org"), para que la cookie de sesión viaje entre los
# dos si están en subdominios separados. Vacío en local.
COOKIE_DOMAIN=""

# ── Seed del usuario Admin General maestro (ver prisma/seed.ts) ──
# Solo ADMIN_EMAIL es obligatorio.
# En VPS (con terminal interactiva): dejá ADMIN_PASSWORD vacío — el seed
# genera una contraseña aleatoria y la muestra UNA vez en la consola.
# En Hostinger Node.js App (sin terminal interactiva): definí vos
# ADMIN_PASSWORD acá antes del primer deploy (generala con un gestor de
# contraseñas) — es más confiable que depender de poder leer los logs de
# build para encontrar una generada automáticamente.
ADMIN_EMAIL="admin@vidasolidaria.org"
ADMIN_NAME="Admin General"
# ADMIN_PASSWORD=""
