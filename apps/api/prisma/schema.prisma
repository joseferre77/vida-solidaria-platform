// ============================================================
// Vida Solidaria — Plataforma de Gestión
// Prisma schema — versión ejecutable del modelo descrito en ARCHITECTURE.md
// Estado: modelo de datos inicial (Fase de diseño). Sin lógica de negocio
// todavía — eso llega con el Módulo 1 (Core & Seguridad).
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ────────────────────────────────────────────────
// 1. CORE & SEGURIDAD (RBAC)
// ────────────────────────────────────────────────

enum UserStatus {
  active
  // Fase K bloque A: alta pública de voluntarios desde vidasolidariamdp.com.
  // `pending` = se registró solo, espera aprobación de la comisión.
  // `rejected` = la comisión decidió no darlo de alta (no se reactiva desde
  // acá — si más adelante hace falta reconsiderar, se agrega a mano).
  pending
  rejected
  suspended
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  googleId     String?    @unique @map("google_id")
  name         String
  phone        String?
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(active)
  // Motivo/mensaje que la persona escribió en el formulario público de alta
  // (vidasolidariamdp.com). Null para usuarios creados a mano desde gestión.
  volunteerMessage String? @map("volunteer_message")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  projectMembership ProjectMember[]
  ownedProjects     Project[]        @relation("project_owner")
  taskAssignments   TaskAssignee[]
  taskComments      TaskComment[]
  auditEntries      AuditLog[]       @relation("audit_actor")
  timeEntries       TimeEntry[]
  surveyResponses   SurveyResponse[]
  projectExpenses   ProjectExpense[]
  projectNotes      ProjectNote[]

  @@map("users")
}

/// Contador atómico genérico (incrementar dentro de una transacción para
/// evitar colisiones) — se usa para numeración secuencial tipo "PROY-0001"
/// o, cuando se implemente el Módulo 3, "C000123" para Casos.
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

model Role {
  id          String           @id @default(uuid())
  slug        String           @unique // admin_general, direccion_general, direccion_proyectos,
  // coordinacion_logistica, coordinacion_comercial,
  // coordinacion_recepcion, coordinacion_extraccion,
  // coordinador_relevamiento, voluntario
  label       String
  rank        Int // menor = más alcance
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id    String @id @default(uuid())
  slug  String @unique // cases.write, finance.read, projects.admin, ...
  label String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  diff       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation("audit_actor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_log")
}

// ────────────────────────────────────────────────
// 2. GESTIÓN DE PROYECTOS
// ────────────────────────────────────────────────

enum ProjectStatus {
  planning
  active
  paused
  done
}

enum ProjectRole {
  creador
  editor
  visor
  admin
}

model Project {
  id          String        @id @default(uuid())
  code        String        @unique // ej. PROY-0001, vía Counter "project_code"
  name        String
  description String?
  area        String?
  status      ProjectStatus @default(planning)
  priority    TaskPriority  @default(media)
  budget      Decimal?      @db.Decimal(12, 2)
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  ownerId     String        @map("owner_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  owner            User                @relation("project_owner", fields: [ownerId], references: [id])
  members          ProjectMember[]
  boards           Board[]
  fundTransactions FundTransaction[]
  cases            ProjectCase[]
  milestones       ProjectMilestone[]
  attachments      ProjectAttachment[]
  labels           ProjectLabel[]
  processes        ProjectProcess[]
  expenses         ProjectExpense[]
  notes            ProjectNote[]
  settings         ProjectSettings?

  @@map("projects")
}

model ProjectMember {
  projectId   String      @map("project_id")
  userId      String      @map("user_id")
  projectRole ProjectRole @map("project_role")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

/// Vínculo muchos-a-muchos entre Proyectos y Casos: un proyecto comunitario
/// (ej. "Comedor de los sábados") puede atender a muchos casos, y un caso
/// puede estar involucrado en varios proyectos a la vez (vivienda, empleo).
model ProjectCase {
  projectId String   @map("project_id")
  caseId    String   @map("case_id")
  linkedBy  String   @map("linked_by")
  linkedAt  DateTime @default(now()) @map("linked_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  case    Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@id([projectId, caseId])
  @@map("project_cases")
}

enum MilestoneStatus {
  pendiente
  completado
}

model ProjectMilestone {
  id          String          @id @default(uuid())
  projectId   String          @map("project_id")
  title       String
  description String?
  dueDate     DateTime?       @map("due_date")
  status      MilestoneStatus @default(pendiente)
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_milestones")
}

model ProjectAttachment {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  fileUrl    String   @map("file_url")
  fileName   String   @map("file_name")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_attachments")
}

/// Etiquetas reutilizables (no texto libre) para filtrar proyectos y tareas.
model Label {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#6366F1")
  createdAt DateTime @default(now()) @map("created_at")

  projects ProjectLabel[]
  tasks    TaskLabel[]

  @@map("labels")
}

model ProjectLabel {
  projectId String @map("project_id")
  labelId   String @map("label_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label   Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([projectId, labelId])
  @@map("project_labels")
}

/// "Proceso": agrupador de tareas dentro de un proyecto (ej. "Diagnostico",
/// "Ejecucion", "Cierre"). Es ortogonal a las columnas del Kanban (Board/
/// BoardColumn, que reflejan ESTADO: To Do/Doing/Done): un Proceso agrupa
/// tareas por ETAPA del proyecto y se usa como filtro en el Kanban y como
/// eje de agrupacion en la vista "Plan" (Gantt).
model ProjectProcess {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  color     String   @default("#6366F1")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("project_processes")
}

model Board {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns BoardColumn[]

  @@map("boards")
}

model BoardColumn {
  id        String @id @default(uuid())
  boardId   String @map("board_id")
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@map("board_columns")
}

enum TaskPriority {
  baja
  media
  alta
}

model Task {
  id               String       @id @default(uuid())
  boardColumnId    String       @map("board_column_id")
  title            String
  description      String?
  priority         TaskPriority @default(media)
  startDate        DateTime?    @map("start_date")
  dueDate          DateTime?    @map("due_date")
  estimatedMinutes Int?         @map("estimated_minutes")
  processId        String?      @map("process_id")
  createdBy        String       @map("created_by")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  boardColumn BoardColumn         @relation(fields: [boardColumnId], references: [id], onDelete: Cascade)
  process     ProjectProcess?     @relation(fields: [processId], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]
  comments    TaskComment[]
  attachments TaskAttachment[]
  checklist   TaskChecklistItem[]
  timeEntries TimeEntry[]
  labels      TaskLabel[]
  blockerOf   TaskDependency[]    @relation("task_blocker")
  blockedBy   TaskDependency[]    @relation("task_blocked")

  @@map("tasks")
}

model TaskAssignee {
  taskId String @map("task_id")
  userId String @map("user_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignees")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  fileUrl    String   @map("file_url")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_attachments")
}

model TaskChecklistItem {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  title     String
  isChecked Boolean  @default(false) @map("is_checked")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_checklist_items")
}

/// "Esta tarea no puede avanzar hasta que termine la tarea bloqueadora."
/// Deliberadamente simple (sin tipos de dependencia estilo finish-to-start).
model TaskDependency {
  id            String   @id @default(uuid())
  blockerTaskId String   @map("blocker_task_id")
  blockedTaskId String   @map("blocked_task_id")
  createdAt     DateTime @default(now()) @map("created_at")

  blockerTask Task @relation("task_blocker", fields: [blockerTaskId], references: [id], onDelete: Cascade)
  blockedTask Task @relation("task_blocked", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockerTaskId, blockedTaskId])
  @@map("task_dependencies")
}

model TaskLabel {
  taskId  String @map("task_id")
  labelId String @map("label_id")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

/// Cronómetro en vivo (ledger de tramos, nunca un campo "horas actuales"
/// mutable — mismo criterio que stock/finanzas). Mientras `endedAt` sea
/// null, el cronómetro está corriendo. Regla de negocio (se aplica en la
/// capa de servicio, no acá): un usuario solo puede tener UN tramo abierto
/// a la vez en todo el sistema — arrancar uno nuevo cierra el anterior.
model TimeEntry {
  id        String    @id @default(uuid())
  taskId    String    @map("task_id")
  userId    String    @map("user_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt])
  @@map("time_entries")
}

// ────────────────────────────────────────────────
// 2.5 EXTENSIONES GENÉRICAS: CAMPOS PERSONALIZADOS Y ENCUESTAS
// (aplican a Proyectos y, cuando se implemente, a Casos)
// ────────────────────────────────────────────────

enum CustomFieldEntity {
  PROJECT
  CASE
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

/// Definición de un campo extra (EAV simplificado, patrón tomado de RISE
/// CRM pero tipado): se crea desde un panel de admin, sin migración.
model CustomFieldDefinition {
  id          String            @id @default(uuid())
  entity      CustomFieldEntity
  label       String
  fieldType   CustomFieldType   @map("field_type")
  options     String[] // solo aplica a SELECT / MULTI_SELECT
  required    Boolean           @default(false)
  sortOrder   Int               @default(0) @map("sort_order")
  showInTable Boolean           @default(false) @map("show_in_table")
  filterable  Boolean           @default(false)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  values CustomFieldValue[]

  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id           String @id @default(uuid())
  definitionId String @map("definition_id")
  entityId     String @map("entity_id") // id de Project o Case según definition.entity
  value        Json

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@map("custom_field_values")
}

enum SurveyEntity {
  PROJECT
  CASE
  STANDALONE
}

enum SurveyQuestionType {
  TEXT
  NUMBER
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE
  BOOLEAN
  DATE
}

/// Encuestas de uso interno (las responde gente logueada). `entityId` es
/// polimórfico según `entity` (id de Project o Case), null si es standalone.
model Survey {
  id          String       @id @default(uuid())
  title       String
  description String?
  entity      SurveyEntity @default(STANDALONE)
  entityId    String?      @map("entity_id")
  createdBy   String       @map("created_by")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@map("surveys")
}

model SurveyQuestion {
  id        String             @id @default(uuid())
  surveyId  String             @map("survey_id")
  label     String
  type      SurveyQuestionType
  options   String[] // aplica a SINGLE_CHOICE / MULTIPLE_CHOICE
  required  Boolean            @default(false)
  sortOrder Int                @default(0) @map("sort_order")

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@map("survey_questions")
}

model SurveyResponse {
  id               String   @id @default(uuid())
  surveyId         String   @map("survey_id")
  respondentUserId String   @map("respondent_user_id")
  submittedAt      DateTime @default(now()) @map("submitted_at")

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [respondentUserId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@map("survey_responses")
}

model SurveyAnswer {
  id         String @id @default(uuid())
  responseId String @map("response_id")
  questionId String @map("question_id")
  value      Json

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@map("survey_answers")
}

// ────────────────────────────────────────────────
// 2.6 PROYECTOS: EXTENSIONES DE UI (Gastos, Notas, Recordatorios, Config)
// ────────────────────────────────────────────────

/// Gasto imputado a un proyecto (pestaña "Gastos"). Es un ledger -- cada fila
/// es un gasto puntual con su propia fecha; nunca se edita un total
/// acumulado (misma convencion que stock_movements / fund_transactions).
model ProjectExpense {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  caseId      String?  @map("case_id") // "Cliente": opcional, si el gasto es imputable a un caso puntual
  memberId    String   @map("member_id") // "Miembro": quien genero el gasto
  category    String
  title       String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  expenseDate DateTime @map("expense_date")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  case    Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  member  User    @relation(fields: [memberId], references: [id])

  @@map("project_expenses")
}

/// Nota interna de proyecto (pestaña "Notas"): distinta de TaskComment,
/// vive a nivel proyecto y no cuelga de una tarea puntual.
model ProjectNote {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  authorId  String   @map("author_id")
  content   String
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@map("project_notes")
}

enum ReminderEntity {
  PROJECT
  TASK
}

/// Recordatorio generico (proyecto o tarea) -- mismo patron entity+entityId
/// que CustomFieldValue/Survey, para no tener que crear una tabla nueva por
/// cada tipo de entidad que necesite recordatorios en el futuro.
model Reminder {
  id         String         @id @default(uuid())
  entity     ReminderEntity
  entityId   String         @map("entity_id")
  title      String
  remindAt   DateTime       @map("remind_at")
  isDone     Boolean        @default(false) @map("is_done")
  notifiedAt DateTime?      @map("notified_at")
  createdBy  String         @map("created_by")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("reminders")
}

/// Configuracion por proyecto (pestaña "Configuraciones"). Uno a uno con
/// Project; "extra" queda como escape hatch para toggles futuros sin
/// necesitar una migracion nueva por cada uno.
model ProjectSettings {
  projectId             String  @id @map("project_id")
  membersCanTrackTime   Boolean @default(true) @map("members_can_track_time")
  membersCanLogExpenses Boolean @default(true) @map("members_can_log_expenses")
  taskApprovalRequired  Boolean @default(false) @map("task_approval_required")
  isArchived            Boolean @default(false) @map("is_archived")
  extra                 Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_settings")
}

// ────────────────────────────────────────────────
// 3. CRM SOCIAL — MÓDULO "CASOS"
// ────────────────────────────────────────────────

enum CaseStatus {
  activo
  en_seguimiento
  derivado
  cerrado
}

enum NeedCategory {
  salud
  documentacion
  abrigo
  alimentacion
  vivienda
  laboral
  otro
}

enum NeedUrgency {
  inmediata
  urgente
  normal
}

// Fase J — campos de relevamiento móvil (reemplazo de la planilla en
// papel). Se agregan como columnas nuevas y opcionales sobre Case en vez
// de modelar tablas aparte porque son atributos propios de identidad/
// diagnóstico de LA persona, no eventos repetibles — lo que sí es
// repetible (necesidades, habilidades, fotos, ubicaciones, contactos) ya
// tenía su propia tabla desde antes y se reusa tal cual.
enum CaseType {
  individual
  pareja
  grupo_familiar
}

enum StayType {
  calle
  parador_temporal
}

enum CaseViability {
  alta
  media
  baja
}

enum CaseFeasibility {
  factible
  no_factible
  en_pausa
}

model Case {
  id               String     @id @default(uuid())
  caseNumber       String     @unique @map("case_number") // ej. C000123, asignado por Counter en el service
  fullName         String     @map("full_name")
  alias            String?
  approxAge        Int?       @map("approx_age")
  mainPhotoUrl     String?    @map("main_photo_url")
  healthStatus     String?    @map("health_status")
  currentSleepSpot String?    @map("current_sleep_spot")
  status           CaseStatus @default(activo)
  createdBy        String     @map("created_by")
  updatedBy        String?    @map("updated_by")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  // Relevamiento móvil (Fase J)
  caseType        CaseType         @default(individual) @map("case_type")
  dni             String?
  sex             String?
  phone           String?
  dayZone         String?          @map("day_zone") // zona habitual de circulación diurna; currentSleepSpot ya cubre dónde duerme
  stayType        StayType?        @map("stay_type")
  wantsToWork     Boolean?         @map("wants_to_work")
  workAptitude    String?          @map("work_aptitude")
  legalSituation  String?          @map("legal_situation")
  substanceUse    String?          @map("substance_use")
  viability       CaseViability?
  feasibility     CaseFeasibility?
  closeReason     String?          @map("close_reason")

  contactsHistory CaseContactHistory[]
  locations       CaseLocation[]
  photos          CasePhoto[]
  skills          CaseSkill[]
  needs           CaseNeed[]
  statusHistory   CaseStatusHistory[]
  checkins        Checkin[]
  projects        ProjectCase[]
  expenses        ProjectExpense[]
  members         CaseMember[]
  assignments     CaseAssignment[]

  @@map("cases")
}

// Integrantes adicionales de un caso "pareja" / "grupo_familiar" — el
// primer integrante (el "referente" del grupo) sigue viviendo en los
// campos de Case de arriba, sin cambios, para no tocar los casos ya
// cargados. CaseMember cubre al RESTO del grupo: cada uno con sus
// propios datos, patologías/diagnóstico y necesidades/habilidades.
model CaseMember {
  id             String   @id @default(uuid())
  caseId         String   @map("case_id")
  fullName       String   @map("full_name")
  alias          String?
  approxAge      Int?     @map("approx_age")
  dni            String?
  sex            String?
  healthStatus   String?  @map("health_status")
  wantsToWork    Boolean? @map("wants_to_work")
  workAptitude   String?  @map("work_aptitude")
  legalSituation String?  @map("legal_situation")
  substanceUse   String?  @map("substance_use")
  createdAt      DateTime @default(now()) @map("created_at")

  case   Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  needs  CaseNeed[]
  skills CaseSkill[]
  photos CasePhoto[]

  @@map("case_members")
}

model CaseContactHistory {
  id           String   @id @default(uuid())
  caseId       String   @map("case_id")
  userId       String   @map("user_id")
  notes        String
  moodObserved String?  @map("mood_observed")
  contactedAt  DateTime @default(now()) @map("contacted_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_contacts_history")
}

model CaseLocation {
  id         String   @id @default(uuid())
  caseId     String   @map("case_id")
  lat        Float
  lng        Float
  recordedBy String   @map("recorded_by")
  recordedAt DateTime @default(now()) @map("recorded_at")
  // Nota: en la migración SQL real este par lat/lng se acompaña de una
  // columna `geog geography(Point,4326)` generada, para poder indexar con
  // GiST y hacer consultas de proximidad ("casos relevados a <500m").

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_locations")
}

model CasePhoto {
  id           String   @id @default(uuid())
  caseId       String   @map("case_id")
  caseMemberId String?  @map("case_member_id") // null = del caso/referente; seteado = foto de un integrante puntual
  url          String
  uploadedBy   String   @map("uploaded_by")
  takenAt      DateTime @default(now()) @map("taken_at")

  case   Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  member CaseMember? @relation(fields: [caseMemberId], references: [id], onDelete: Cascade)

  @@map("case_photos")
}

model CaseSkill {
  id           String  @id @default(uuid())
  caseId       String  @map("case_id")
  caseMemberId String? @map("case_member_id") // null = del caso/referente; seteado = de un integrante puntual
  skillLabel   String  @map("skill_label")
  level        String?

  case   Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  member CaseMember? @relation(fields: [caseMemberId], references: [id], onDelete: Cascade)

  @@map("case_skills")
}

model CaseNeed {
  id           String       @id @default(uuid())
  caseId       String       @map("case_id")
  caseMemberId String?      @map("case_member_id") // null = necesidad del grupo/referente; seteado = de un integrante puntual
  category     NeedCategory
  urgency      NeedUrgency
  notes        String?
  resolvedAt   DateTime?    @map("resolved_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  case   Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  member CaseMember? @relation(fields: [caseMemberId], references: [id], onDelete: Cascade)

  @@map("case_needs")
}

model CaseStatusHistory {
  id         String      @id @default(uuid())
  caseId     String      @map("case_id")
  fromStatus CaseStatus? @map("from_status")
  toStatus   CaseStatus  @map("to_status")
  changedBy  String      @map("changed_by")
  changedAt  DateTime    @default(now()) @map("changed_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_status_history")
}

// Fase K bloque D: quién lleva cada caso. Un caso puede tener varios
// usuarios a la vez con roles distintos (o el mismo rol repetido — ej. dos
// visitadores sociales). No se borra al desasignar (`unassignedAt` marca
// el fin en vez de un delete) para conservar el historial de quién pasó
// por el caso — alimenta el bloque G más adelante. `userId` es un campo
// suelto (sin @relation a User), mismo criterio que el resto del módulo.
enum CaseAssignmentRole {
  coordinador
  visitador_social
  psicologo
  seguimiento_laboral
  seguimiento_conducta
}

model CaseAssignment {
  id           String             @id @default(uuid())
  caseId       String             @map("case_id")
  userId       String             @map("user_id")
  role         CaseAssignmentRole
  assignedAt   DateTime           @default(now()) @map("assigned_at")
  unassignedAt DateTime?          @map("unassigned_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_assignments")
}

// ────────────────────────────────────────────────
// 4. LOGÍSTICA, INVENTARIO Y STOCK
// ────────────────────────────────────────────────

model DonorInKind {
  id      String  @id @default(uuid())
  name    String
  contact String?
  type    String // individuo | empresa

  intakes DonationIntake[]

  @@map("donors_in_kind")
}

model DonationIntake {
  id              String   @id @default(uuid())
  donorId         String?  @map("donor_id")
  receivedBy      String   @map("received_by") // recolector
  itemDescription String   @map("item_description")
  quantity        Decimal
  unit            String
  destinationNote String?  @map("destination_note")
  receivedAt      DateTime @default(now()) @map("received_at")

  donor DonorInKind? @relation(fields: [donorId], references: [id], onDelete: SetNull)

  @@map("donation_intakes")
}

enum StockUnit {
  kg
  litros
  unidades
  paquetes
  cajas
}

model StockItem {
  id   String @id @default(uuid())
  // Código legible tipo "ART-0001" (vía Counter "stock_item_code", mismo
  // patrón que Case.caseNumber/Project.code) — el id automático que pidió
  // Josecito para el catálogo.
  code String @unique
  name String
  unit StockUnit
  category String?
  // Fase K: distingue insumos que se consumen (materia prima, descartables)
  // de equipamiento que se PRESTA y vuelve (conservadoras, termos, ollas,
  // cucharones) — este último no se mueve por StockMovement, se rastrea por
  // custodia (quién lo tiene ahora) en StockCustody.
  isReusable Boolean @default(false) @map("is_reusable")
  // Valuación monetaria: costo por unidad — el valor total se calcula
  // (cantidad actual, que sale de sumar StockMovement × unitCost), nunca se
  // guarda como campo mutable (misma convención que el resto del ledger).
  unitCost Decimal? @map("unit_cost")
  // Punto de pedido (cuándo alertar que hay que comprar/conseguir más) y
  // punto de reposición (a qué nivel reponer) — dos umbrales distintos,
  // reemplaza al viejo `minStockAlert` (nunca tuvo datos en producción).
  reorderPoint  Decimal? @map("reorder_point")
  restockTarget Decimal? @map("restock_target")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  movements   StockMovement[]
  kitchenUses KitchenBatchIngredient[]
  custodies   StockCustody[]

  @@map("stock_items")
}

// Fase K: préstamo de equipamiento reusable (StockItem.isReusable = true) a
// un usuario — ej. "Juan tiene las 3 conservadoras desde el domingo, las
// devuelve a lo de Lourdes el miércoles". No reemplaza StockMovement (eso
// sigue siendo el ledger de ingreso/egreso de lo que se consume); esto es
// puramente "quién tiene qué ahora", con historial de préstamos pasados.
model StockCustody {
  id            String    @id @default(uuid())
  stockItemId   String    @map("stock_item_id")
  holderUserId  String    @map("holder_user_id")
  quantity      Decimal   @default(1)
  notes         String?
  checkedOutBy  String    @map("checked_out_by")
  checkedOutAt  DateTime  @default(now()) @map("checked_out_at")
  returnedAt    DateTime? @map("returned_at")
  returnedNotes String?   @map("returned_notes")

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
  @@map("stock_custody")
}

enum MovementType {
  ingreso
  egreso
}

model StockMovement {
  id                String       @id @default(uuid())
  stockItemId       String       @map("stock_item_id")
  type              MovementType
  quantity          Decimal
  reason            String?
  relatedEntityType String?      @map("related_entity_type") // "kitchen_batch" | "field_delivery" | ...
  relatedEntityId   String?      @map("related_entity_id")
  createdBy         String       @map("created_by")
  createdAt         DateTime     @default(now()) @map("created_at")

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
  @@map("stock_movements")
}

enum KitchenBatchStatus {
  preparacion
  coccion
  // Fase K: dos pasos nuevos entre "cocción" y "entregado" — la cocina
  // terminó de cocinar (cocina_terminada) antes de empezar a cargar las
  // conservadoras (se reusa el valor existente `listo_transporte`, ver
  // KITCHEN_STATUS_LABEL en el frontend), y ya en viaje hacia el punto de
  // encuentro (camino_punto_encuentro) antes de la entrega final.
  cocina_terminada
  listo_transporte // relabeled en frontend como "Cargando conservadoras"
  camino_punto_encuentro
  entregado
}

model KitchenBatch {
  id             String             @id @default(uuid())
  name           String
  targetServings Int                @map("target_servings")
  status         KitchenBatchStatus @default(preparacion)
  createdBy      String             @map("created_by")
  // Fase K: la persona a cargo de ESTA cocina puntual (distinto de la lista
  // de `assignees`, que son las personas que ayudan) — pedido de Josecito,
  // hoy no había forma de marcar "quién responde por este lote".
  responsibleUserId String?         @map("responsible_user_id")
  createdAt      DateTime           @default(now()) @map("created_at")

  ingredients   KitchenBatchIngredient[]
  assignees     KitchenBatchAssignee[]
  statusHistory KitchenBatchStatusHistory[]
  checkins      Checkin[]

  @@map("kitchen_batches")
}

model KitchenBatchIngredient {
  batchId          String  @map("batch_id")
  stockItemId      String  @map("stock_item_id")
  quantityAssigned Decimal @map("quantity_assigned")

  batch     KitchenBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stockItem StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@id([batchId, stockItemId])
  @@map("kitchen_batch_ingredients")
}

model KitchenBatchAssignee {
  batchId   String  @map("batch_id")
  userId    String  @map("user_id")
  taskLabel String? @map("task_label")

  batch KitchenBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([batchId, userId])
  @@map("kitchen_batch_assignees")
}

model KitchenBatchStatusHistory {
  id        String             @id @default(uuid())
  batchId   String             @map("batch_id")
  toStatus  KitchenBatchStatus @map("to_status")
  changedBy String             @map("changed_by")
  changedAt DateTime           @default(now()) @map("changed_at")

  batch KitchenBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("kitchen_batch_status_history")
}

// ────────────────────────────────────────────────
// 5. OPERACIONES DE CAMPO (TIEMPO REAL)
// ────────────────────────────────────────────────

model FieldTeam {
  id           String  @id @default(uuid())
  name         String
  vehicleLabel String? @map("vehicle_label")

  members         FieldTeamMember[]
  zoneAssignments ZoneAssignment[]
  checkins        Checkin[]

  @@map("field_teams")
}

// Fase K bloque B: los equipos se arman de nuevo cada domingo a partir de
// quién confirmó asistencia esa semana (ver WeeklyAvailability) — por eso
// ahora la membresía está atada a una semana puntual (weekStartDate), no es
// fija en el tiempo. Antes la clave primaria era (teamId, userId); en
// producción esta tabla está vacía (se confirmó antes de migrar), así que
// no hace falta backfill: se puede cambiar la forma de la clave directo.
model FieldTeamMember {
  id            String   @id @default(uuid())
  teamId        String   @map("team_id")
  userId        String   @map("user_id")
  weekStartDate DateTime @map("week_start_date")

  team FieldTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, weekStartDate])
  @@map("field_team_members")
}

// Fase K bloque B: intención semanal de cada voluntario/a ("¿venís este
// domingo?") + confirmación posterior de coordinación. userId es un campo
// "suelto" (sin @relation a User), mismo criterio que en Checkin/FieldTeamMember
// — se resuelve con userMapFor()/usersWithPermission() en las rutas, no con
// un include de Prisma.
model WeeklyAvailability {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  weekStartDate    DateTime  @map("week_start_date")
  willAttend       Boolean   @map("will_attend")
  reason           String?   @map("reason")
  // null = coordinación todavía no decidió; true/false = ya se definió si
  // esta persona queda confirmada para el equipo de la semana.
  confirmedPresent Boolean?  @map("confirmed_present")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([userId, weekStartDate])
  @@map("weekly_availabilities")
}

model Zone {
  id   String @id @default(uuid())
  name String
  // El polígono real se define en la migración SQL como
  // `geography(Polygon,4326)`; acá se referencia solo el id/nombre.

  assignments ZoneAssignment[]

  @@map("zones")
}

model ZoneAssignment {
  id            String   @id @default(uuid())
  zoneId        String   @map("zone_id")
  teamId        String   @map("team_id")
  weekStartDate DateTime @map("week_start_date")
  weekEndDate   DateTime @map("week_end_date")

  zone Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  team FieldTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("zone_assignments")
}

enum CheckinType {
  en_camino
  llegamos
  // Fase K bloque B: presentismo en dos etapas — primero en el punto de
  // encuentro fijo (Bv. Marítimo y Av. P. Peralta Ramos 2502), después ya
  // en la zona asignada. `llegamos` queda como estaba (uso genérico previo
  // a este bloque) para no romper checkins históricos; los nuevos flujos de
  // presentismo usan estos dos tipos, más específicos.
  presente_punto_encuentro
  presente_zona
  entregando_viandas
  relevando_caso
}

model Checkin {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  teamId         String?     @map("team_id")
  type           CheckinType
  caseId         String?     @map("case_id")
  kitchenBatchId String?     @map("kitchen_batch_id")
  lat            Float
  lng            Float
  createdAt      DateTime    @default(now()) @map("created_at")

  team         FieldTeam?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  case         Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  kitchenBatch KitchenBatch?   @relation(fields: [kitchenBatchId], references: [id], onDelete: SetNull)
  deliveries   FieldDelivery[]

  @@map("checkins")
}

model FieldDelivery {
  id        String  @id @default(uuid())
  checkinId String  @map("checkin_id")
  itemLabel String  @map("item_label")
  quantity  Decimal

  checkin Checkin @relation(fields: [checkinId], references: [id], onDelete: Cascade)

  @@map("field_deliveries")
}

// ────────────────────────────────────────────────
// 6. FINANZAS Y DONACIONES
// ────────────────────────────────────────────────

model Lead {
  id                String   @id @default(uuid())
  type              String // donante | empresa | voluntario
  name              String
  email             String?
  phone             String?
  source            String? // formulario web, campaña, etc.
  payload           Json?
  convertedToUserId String?  @map("converted_to_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("leads")
}

model DonorMonetary {
  id        String  @id @default(uuid())
  name      String
  email     String?
  phone     String?
  isCompany Boolean @default(false) @map("is_company")

  transactions FundTransaction[]

  @@map("donors_monetary")
}

enum FundTransactionType {
  ingreso
  egreso
}

enum FundMethod {
  transferencia
  efectivo
}

model FundTransaction {
  id                   String              @id @default(uuid())
  type                 FundTransactionType
  method               FundMethod
  amount               Decimal
  currency             String              @default("ARS")
  donorId              String?             @map("donor_id")
  originNote           String?             @map("origin_note")
  destinationProjectId String?             @map("destination_project_id")
  executedBy           String              @map("executed_by")
  occurredAt           DateTime            @default(now()) @map("occurred_at")

  donor              DonorMonetary? @relation(fields: [donorId], references: [id], onDelete: SetNull)
  destinationProject Project?       @relation(fields: [destinationProjectId], references: [id], onDelete: SetNull)

  @@map("fund_transactions")
}

model FinancialReport {
  id          String   @id @default(uuid())
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  totals      Json
  generatedBy String   @map("generated_by")
  generatedAt DateTime @default(now()) @map("generated_at")
  publicUrl   String?  @map("public_url")

  @@map("financial_reports")
}

// ────────────────────────────────────────────────
// 7. ANALÍTICA — sin tablas propias en v1 (ver ARCHITECTURE.md §4.7)
// ────────────────────────────────────────────────

// ────────────────────────────────────────────────
// FASE K — Notificaciones "en el sistema" (campanita en la barra superior)
// ────────────────────────────────────────────────

// Genérico a propósito (no es solo de Stock): pensado para reusarse en
// cualquier alerta futura — stock bajo, asignación/cierre de un caso, alta
// de voluntario aprobada, etc. Ver `apps/api/src/lib/notify.ts`.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  body      String?
  link      String?
  type      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}
