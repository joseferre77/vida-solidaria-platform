# /etc/nginx/sites-available/vida-solidaria
# Reemplazá TU_SUBDOMINIO (ej. app.vidasolidaria.org) antes de activarlo.
# La terminación TLS la agrega certbot automáticamente al correr
# `certbot --nginx -d TU_SUBDOMINIO` (agrega el bloque 443 y el redirect).

server {
    listen 80;
    server_name TU_SUBDOMINIO;

    client_max_body_size 20m;   # fotos de casos / donaciones vía @fastify/multipart

    # Frontend (Next.js, PM2 proceso "web" en :3000)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend (Fastify, PM2 proceso "api" en :4000) + WebSocket (Socket.IO)
    location /api/ {
        proxy_pass http://127.0.0.1:4000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
